<Window x:Class="MTGOOverlay.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calibrate Card Preview Area"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#40000000"
        Cursor="Cross"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp"
        KeyDown="Window_KeyDown">
    <Canvas x:Name="OverlayCanvas">
        <Border x:Name="SelectionBox"
                BorderBrush="#00FFCC"
                BorderThickness="2"
                Background="#3000FFCC"
                Visibility="Collapsed" />

        <Border Background="#D01A1C21"
                CornerRadius="8"
                Padding="16,10"
                BorderBrush="#00FFCC"
                BorderThickness="1"
                Canvas.Left="30"
                Canvas.Top="30">
            <StackPanel>
                <TextBlock Text="🎯 请用鼠标左键拖动框选 MTGO 的【卡牌英文名称横条】"
                           Foreground="#FFFFFF"
                           FontSize="15"
                           FontWeight="Bold" />
                <TextBlock Text="• 仅框选卡牌顶部的英文名称文字条即可（无需框选整张大卡牌）"
                           Foreground="#A1A1AA"
                           FontSize="12"
                           Margin="0,4,0,0" />
                <TextBlock Text="• 框选后松开鼠标即生效，后续可随时直接拖拽微调"
                           Foreground="#FFAD42"
                           FontSize="12"
                           Margin="0,2,0,0" />
                <TextBlock Text="• 按 ESC 或鼠标右键取消"
                           Foreground="#FF7B72"
                           FontSize="12"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>

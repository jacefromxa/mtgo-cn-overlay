<Window x:Class="MTGOOverlay.CaptureBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MTGO OCR Capture Box"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Loaded="Window_Loaded">
    <Window.Resources>
        <!-- Resizing Edge Thumb Style -->
        <Style x:Key="EdgeThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle Fill="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Resizing Corner Thumb Style -->
        <Style x:Key="CornerThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="#FFAD42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#14161B"
                                BorderThickness="1"
                                CornerRadius="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- Row 0: Header / Control Bar (Collapsed in locked mode) -->
            <RowDefinition x:Name="HeaderRow" Height="26"/>
            <!-- Row 1: Capture Frame Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar (Draggable, with live feedback & Lock button) -->
        <Border x:Name="HeaderBar"
                Grid.Row="0"
                Background="#EE14161B"
                BorderBrush="#FFAD42"
                BorderThickness="1,1,1,0"
                CornerRadius="4,4,0,0"
                Padding="6,2"
                Cursor="SizeAll"
                MouseDown="HeaderBar_MouseDown">
            <DockPanel LastChildFill="True">
                <!-- Settings & Lock Buttons on Right -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnSettings"
                            Content="⚙ 设置"
                            FontSize="11"
                            Padding="6,2"
                            Margin="4,0,0,0"
                            Background="#2A303C"
                            Foreground="#CBD5E1"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnSettings_Click"/>
                    <Button x:Name="BtnLock"
                            Content="🔒 锁定穿透"
                            FontSize="11"
                            Padding="6,2"
                            Margin="4,0,0,0"
                            Background="#FFAD42"
                            Foreground="#000000"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnLock_Click"/>
                </StackPanel>

                <!-- Size badge -->
                <TextBlock x:Name="TxtSize"
                           DockPanel.Dock="Left"
                           Text="280 × 34"
                           Foreground="#FFAD42"
                           FontSize="11"
                           FontFamily="Consolas, Segoe UI"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <!-- Live feedback badge -->
                <TextBlock x:Name="TxtFeedback"
                           Text="⚪ 等待卡牌..."
                           Foreground="#E2E8F0"
                           FontSize="11"
                           FontWeight="Normal"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Capture Area Border -->
        <Grid Grid.Row="1" x:Name="CaptureContainer">
            <!-- Center Border -->
            <Border x:Name="CaptureBorder"
                    BorderBrush="#FFAD42"
                    BorderThickness="2"
                    CornerRadius="0,0,3,3"
                    Background="#08FFAD42"
                    Cursor="SizeAll"
                    MouseDown="CaptureBorder_MouseDown">
                <!-- Watermark guideline visible only in edit mode -->
                <TextBlock x:Name="TxtGuide"
                           Text="卡名识别区域 (请拖动覆盖至英文卡名上)"
                           Foreground="#A0FFAD42"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Border>

            <!-- 8 Resizing Thumbs (Visible only in edit mode) -->
            <Grid x:Name="ResizeGripsPanel">
                <!-- 4 Edges -->
                <Thumb x:Name="ThumbTop"
                       Style="{StaticResource EdgeThumbStyle}"
                       VerticalAlignment="Top"
                       Height="6"
                       Margin="10,0,10,0"
                       Cursor="SizeNS"
                       DragStarted="Thumb_DragStarted"
                       DragDelta="ThumbTop_DragDelta"
                       DragCompleted="Thumb_DragCompleted"/>

                <Thumb x:Name="ThumbBottom"
                       Style="{StaticResource EdgeThumbStyle}"
                       VerticalAlignment="Bottom"
                       Height="6"
                       Margin="10,0,10,0"
                       Cursor="SizeNS"
                       DragStarted="Thumb_DragStarted"
                       DragDelta="ThumbBottom_DragDelta"
                       DragCompleted="Thumb_DragCompleted"/>

                <Thumb x:Name="ThumbLeft"
                       Style="{StaticResource EdgeThumbStyle}"
                       HorizontalAlignment="Left"
                       Width="6"
                       Margin="0,6,0,6"
                       Cursor="SizeWE"
                       DragStarted="Thumb_DragStarted"
                       DragDelta="ThumbLeft_DragDelta"
                       DragCompleted="Thumb_DragCompleted"/>

                <Thumb x:Name="ThumbRight"
                       Style="{StaticResource EdgeThumbStyle}"
                       HorizontalAlignment="Right"
                       Width="6"
                       Margin="0,6,0,6"
                       Cursor="SizeWE"
                       DragStarted="Thumb_DragStarted"
                       DragDelta="ThumbRight_DragDelta"
                       DragCompleted="Thumb_DragCompleted"/>

                <!-- 4 Corners -->
                <Thumb x:Name="ThumbTopLeft"
                       Style="{StaticResource CornerThumbStyle}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Width="8" Height="8"
                       Cursor="SizeNWSE"
                       DragStarted="Thumb_DragStarted"
                       DragDelta="ThumbTopLeft_DragDelta"
                       DragCompleted="Thumb_DragCompleted"/>

                <Thumb x:Name="ThumbTopRight"
                       Style="{StaticResource CornerThumbStyle}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Width="8" Height="8"
                       Cursor="SizeNESW"
                       DragStarted="Thumb_DragStarted"
                       DragDelta="ThumbTopRight_DragDelta"
                       DragCompleted="Thumb_DragCompleted"/>

                <Thumb x:Name="ThumbBottomLeft"
                       Style="{StaticResource CornerThumbStyle}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Width="8" Height="8"
                       Cursor="SizeNESW"
                       DragStarted="Thumb_DragStarted"
                       DragDelta="ThumbBottomLeft_DragDelta"
                       DragCompleted="Thumb_DragCompleted"/>

                <Thumb x:Name="ThumbBottomRight"
                       Style="{StaticResource CornerThumbStyle}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Width="8" Height="8"
                       Cursor="SizeNWSE"
                       DragStarted="Thumb_DragStarted"
                       DragDelta="ThumbBottomRight_DragDelta"
                       DragCompleted="Thumb_DragCompleted"/>
            </Grid>
        </Grid>
    </Grid>
</Window>

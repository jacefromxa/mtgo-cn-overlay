<Window x:Class="MTGOOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MTGO CN Overlay - 设置与控制中心"
        Icon="app.ico"
        Height="700" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#14161B"
        Foreground="#E2E8F0"
        FontFamily="Segoe UI, Microsoft YaHei"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFAD42"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#1C1F26"/>
            <Setter Property="BorderBrush" Value="#2D333F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A303C"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#3F4756"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#FFAD42"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Margin="0,0,0,10" Padding="0,0,0,8" BorderBrush="#2D333F" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="📁 打开配置目录" Style="{StaticResource ActionButtonStyle}" Click="BtnOpenConfig_Click"/>
                <StackPanel>
                    <TextBlock Text="🎴 MTGO CN Overlay 控制中心" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="万智牌 MTGO 实时汉化识别与浮窗设置" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Scrollable Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-6,0" Padding="0,0,6,0">
            <StackPanel>

                <!-- Section 1: 实时 OCR 诊断与测试 -->
                <TextBlock Text="🔬 实时 OCR 截取与识别诊断 (诊断监控)" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6"/>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <DockPanel LastChildFill="True" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="📸 立即测试截取" Style="{StaticResource PrimaryButtonStyle}" Click="BtnTestCapture_Click"/>
                            <TextBlock Text="当前识别框内捕获的实时图像与 OCR 输出：" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Crop Image Preview -->
                        <Border Background="#0D0E11" BorderBrush="#333A48" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,8" MinHeight="55">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="180">
                                    <TextBlock x:Name="TxtImageSourceBadge" Text="来源: (尚未捕获)" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                    <TextBlock x:Name="TxtImageResolution" Text="分辨率: --" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
                                    <TextBlock Text="※ 100% 原始物理分辨率，无任何长宽比变形压缩" FontSize="10" Foreground="#64748B" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Image x:Name="ImgCropPreview" MaxHeight="140" MaxWidth="240" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- Diagnostic details grid -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="OCR 原始文本: " FontSize="11" Foreground="#94A3B8" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtDiagnosticOcr" Text="(尚未触发截图)" FontSize="11" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,2,0,2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="词库匹配结果: " FontSize="11" Foreground="#94A3B8" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtDiagnosticCard" Text="(等待卡牌)" FontSize="11" FontWeight="Bold" Foreground="#4ADE80" Margin="0,2,0,2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="识别总耗时: " FontSize="11" Foreground="#94A3B8" Margin="0,2,8,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtDiagnosticLatency" Text="-- ms" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,2"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 2: 取词识别模式与触发设置 -->
                <TextBlock Text="🎯 取词识别模式与触发设置 (Capture Mode)" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <DockPanel LastChildFill="True" Margin="0,2,0,4">
                            <TextBlock Text="🔲 Card Preview 停靠窗锚定 (稳定模式)" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                        </DockPanel>
                        <TextBlock Text="通过蓝色识别框精准对齐 MTGO 界面中的 Card Preview 固定预览窗，100% 确保像素画幅无抖动，是最稳定、准确率最高的识别方式。" 
                                   FontSize="11" Foreground="#94A3B8" Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <Separator Background="#2D333F" Margin="0,4,0,8"/>

                        <CheckBox x:Name="ChkRequireCtrl" 
                                  Content="⌨️ 仅在按住 Ctrl 键时弹出汉化浮窗 (熟手推荐：避免频繁弹窗)" 
                                  Foreground="#F8FAFC" FontSize="12" Margin="0,2,0,4"
                                  Checked="ChkRequireCtrl_Changed" Unchecked="ChkRequireCtrl_Changed"/>
                        <TextBlock Text="※ 勾选后，后台仍在高速识别卡牌，但浮窗只在按住 Ctrl 键时才弹出显示；松开则自动隐藏。" 
                                   FontSize="11" Foreground="#94A3B8" Margin="22,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Section 3: 卡名识别框控制 -->
                <TextBlock Text="🔲 卡牌识别框 (Capture Box) 控制" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="TxtCaptureBoxStatus" Text="当前尺寸: 280 × 34 px | 相对坐标: X=40, Y=120" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,10"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="✋ 开启识别框调整 (拖拽/拉伸)" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,6" Click="BtnUnlockCaptureBox_Click"/>
                            <Button Content="🔒 锁定识别框 (开启鼠标穿透)" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,6" Click="BtnLockCaptureBox_Click"/>
                            <Button Content="📐 全屏重新框选卡名横条..." Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,6" Click="BtnCalibrateFull_Click"/>
                        </WrapPanel>
                        <CheckBox x:Name="ChkShowBorder" Content="锁定后保持常驻显示半透明细边框" Foreground="#F8FAFC" FontSize="12" Margin="0,4,0,0" Checked="ChkShowBorder_Changed" Unchecked="ChkShowBorder_Changed"/>
                    </StackPanel>
                </Border>

                <!-- Section 4: 浮窗位置 -->
                <TextBlock Text="📍 汉化浮窗显示位置 (Position)" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <RadioButton x:Name="RbPosFollowCursor" Content="智能追随鼠标 (自适应屏幕左右侧)" 
                                     Foreground="#F8FAFC" FontSize="12" Margin="0,4,0,4" Checked="RbPos_Checked"/>
                        
                        <!-- 避让原生大图选项 (跟随模式下专属) -->
                        <Border Background="#161B26" BorderBrush="#2E384D" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="20,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="ChkAvoidCardZoom" Content="🛡️ 自动避让 MTGO 原生悬浮大图 (并排展示 · 绝不相互遮挡)" 
                                          Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold"
                                          Checked="ChkAvoidCardZoom_Changed" Unchecked="ChkAvoidCardZoom_Changed"/>
                                <TextBlock Text="鼠标停留时，浮窗会自动紧贴游戏原生放大卡牌旁并列展示，既能看清英文大图又能完整阅读中文翻译。" 
                                           FontSize="11" Foreground="#94A3B8" Margin="22,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <RadioButton x:Name="RbPosBesidePreview" Content="停靠在 Card Preview 预览窗旁" 
                                     Foreground="#F8FAFC" FontSize="12" Margin="0,4,0,6" Checked="RbPos_Checked"/>
                        <RadioButton x:Name="RbPosCustomFixed" Content="固定在自定义坐标" 
                                     Foreground="#F8FAFC" FontSize="12" Margin="0,4,0,8" Checked="RbPos_Checked"/>

                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="✋ 拖拽调整浮窗固定位置..." Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,4" Click="BtnMoveOverlay_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Section 5: 汉化浮窗外观与排版样式自定义 -->
                <TextBlock Text="🎨 汉化浮窗外观与排版样式自定义" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <!-- 1. 背景色与透明度 -->
                        <TextBlock Text="■ 浮窗背景与透明度" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,2,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="背景底色:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbBgColor" SelectionChanged="CmbBgColor_SelectionChanged">
                                    <ComboBoxItem Content="炭黑夜色 (#1A1C21)" Tag="#1A1C21"/>
                                    <ComboBoxItem Content="深空极黑 (#0F0F12)" Tag="#0F0F12"/>
                                    <ComboBoxItem Content="群青深蓝 (#0F172A)" Tag="#0F172A"/>
                                    <ComboBoxItem Content="暗石板灰 (#1E293B)" Tag="#1E293B"/>
                                    <ComboBoxItem Content="暗夜酒红 (#2A1115)" Tag="#2A1115"/>
                                    <ComboBoxItem Content="暗幽林绿 (#0E2319)" Tag="#0E2319"/>
                                </ComboBox>
                            </DockPanel>
                            <DockPanel Grid.Column="1" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Right" x:Name="TxtOpacityValue" Text="85%" FontSize="11" Foreground="#FFAD42" Width="36" TextAlignment="Right"/>
                                <TextBlock Text="透明度:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Slider x:Name="SliderOpacity" Minimum="0.30" Maximum="1.0" Value="0.85" SmallChange="0.05" LargeChange="0.10" VerticalAlignment="Center" ValueChanged="SliderOpacity_ValueChanged"/>
                            </DockPanel>
                        </Grid>

                        <Separator Background="#2D333F" Margin="0,4,0,8"/>

                        <!-- 2. 卡牌名称（常驻中英文） -->
                        <TextBlock Text="■ 卡牌名称（常驻双语）" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,2,0,6"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock DockPanel.Dock="Right" x:Name="TxtNameZhSizeValue" Text="16 px" FontSize="11" Foreground="#FFAD42" Width="36" TextAlignment="Right"/>
                                <TextBlock Text="中文名字号:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Slider x:Name="SliderNameZhSize" Minimum="12" Maximum="28" Value="16" SmallChange="1" LargeChange="2" VerticalAlignment="Center" ValueChanged="SliderNameZhSize_ValueChanged"/>
                            </DockPanel>
                            <DockPanel Grid.Column="1">
                                <TextBlock Text="中文颜色:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbNameZhColor" SelectionChanged="CmbNameZhColor_SelectionChanged">
                                    <ComboBoxItem Content="金色 (#FFAD42)" Tag="#FFAD42"/>
                                    <ComboBoxItem Content="纯白 (#FFFFFF)" Tag="#FFFFFF"/>
                                    <ComboBoxItem Content="亮黄 (#FACC15)" Tag="#FACC15"/>
                                    <ComboBoxItem Content="翠绿 (#4ADE80)" Tag="#4ADE80"/>
                                    <ComboBoxItem Content="浅青 (#38BDF8)" Tag="#38BDF8"/>
                                    <ComboBoxItem Content="浅粉 (#F472B6)" Tag="#F472B6"/>
                                </ComboBox>
                            </DockPanel>
                        </Grid>

                        <Grid Margin="0,2,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock DockPanel.Dock="Right" x:Name="TxtNameEnSizeValue" Text="12 px" FontSize="11" Foreground="#FFAD42" Width="36" TextAlignment="Right"/>
                                <TextBlock Text="英文名字号:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Slider x:Name="SliderNameEnSize" Minimum="9" Maximum="20" Value="12" SmallChange="1" LargeChange="2" VerticalAlignment="Center" ValueChanged="SliderNameEnSize_ValueChanged"/>
                            </DockPanel>
                            <DockPanel Grid.Column="1">
                                <TextBlock Text="英文颜色:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbNameEnColor" SelectionChanged="CmbNameEnColor_SelectionChanged">
                                    <ComboBoxItem Content="经典灰 (#A1A1AA)" Tag="#A1A1AA"/>
                                    <ComboBoxItem Content="纯白 (#FFFFFF)" Tag="#FFFFFF"/>
                                    <ComboBoxItem Content="浅金 (#E5C158)" Tag="#E5C158"/>
                                    <ComboBoxItem Content="银灰 (#CBD5E1)" Tag="#CBD5E1"/>
                                    <ComboBoxItem Content="暖白 (#F5F0E6)" Tag="#F5F0E6"/>
                                </ComboBox>
                            </DockPanel>
                        </Grid>

                        <Separator Background="#2D333F" Margin="0,4,0,8"/>

                        <!-- 3. 卡牌类别栏 -->
                        <TextBlock Text="■ 卡牌类别" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,2,0,6"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock DockPanel.Dock="Right" x:Name="TxtTypeSizeValue" Text="12 px" FontSize="11" Foreground="#FFAD42" Width="36" TextAlignment="Right"/>
                                <TextBlock Text="类别字号:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Slider x:Name="SliderTypeSize" Minimum="10" Maximum="20" Value="12" SmallChange="1" LargeChange="2" VerticalAlignment="Center" ValueChanged="SliderTypeSize_ValueChanged"/>
                            </DockPanel>
                            <DockPanel Grid.Column="1">
                                <TextBlock Text="类别颜色:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbTypeColor" SelectionChanged="CmbTypeColor_SelectionChanged">
                                    <ComboBoxItem Content="浅灰 (#A1A1AA)" Tag="#A1A1AA"/>
                                    <ComboBoxItem Content="亮白 (#F1F5F9)" Tag="#F1F5F9"/>
                                    <ComboBoxItem Content="淡青 (#7DD3FC)" Tag="#7DD3FC"/>
                                    <ComboBoxItem Content="浅黄 (#FEF08A)" Tag="#FEF08A"/>
                                </ComboBox>
                            </DockPanel>
                        </Grid>

                        <Separator Background="#2D333F" Margin="0,4,0,8"/>

                        <!-- 4. 异能规则描述与中英文开关 -->
                        <TextBlock Text="■ 异能描述（规则正文）" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,2,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock DockPanel.Dock="Right" x:Name="TxtRulesSizeValue" Text="13 px" FontSize="11" Foreground="#FFAD42" Width="36" TextAlignment="Right"/>
                                <TextBlock Text="中文异能字号:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Slider x:Name="SliderRulesSize" Minimum="10" Maximum="22" Value="13" SmallChange="1" LargeChange="2" VerticalAlignment="Center" ValueChanged="SliderRulesSize_ValueChanged"/>
                            </DockPanel>
                            <DockPanel Grid.Column="1">
                                <TextBlock Text="中文异能颜色:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbRulesColor" SelectionChanged="CmbRulesColor_SelectionChanged">
                                    <ComboBoxItem Content="柔和灰白 (#D4D4D8)" Tag="#D4D4D8"/>
                                    <ComboBoxItem Content="亮白 (#FFFFFF)" Tag="#FFFFFF"/>
                                    <ComboBoxItem Content="象牙白 (#F4F4F5)" Tag="#F4F4F5"/>
                                    <ComboBoxItem Content="暖白 (#FEF9C3)" Tag="#FEF9C3"/>
                                </ComboBox>
                            </DockPanel>
                        </Grid>

                        <!-- English Rules Toggle -->
                        <CheckBox x:Name="ChkShowEnRules" Content="🔤 显示英文异能原文（中英双语对照）" Foreground="#F8FAFC" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,6"
                                  Checked="ChkShowEnRules_Changed" Unchecked="ChkShowEnRules_Changed"/>

                        <StackPanel x:Name="PanelEnRulesOptions" Margin="16,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock DockPanel.Dock="Right" x:Name="TxtEnRulesSizeValue" Text="12 px" FontSize="11" Foreground="#FFAD42" Width="36" TextAlignment="Right"/>
                                    <TextBlock Text="英文异能字号:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Slider x:Name="SliderEnRulesSize" Minimum="9" Maximum="20" Value="12" SmallChange="1" LargeChange="2" VerticalAlignment="Center" ValueChanged="SliderEnRulesSize_ValueChanged"/>
                                </DockPanel>
                                <DockPanel Grid.Column="1">
                                    <TextBlock Text="英文异能颜色:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CmbEnRulesColor" SelectionChanged="CmbEnRulesColor_SelectionChanged">
                                        <ComboBoxItem Content="暗蓝灰 (#94A3B8)" Tag="#94A3B8"/>
                                        <ComboBoxItem Content="浅灰白 (#CBD5E1)" Tag="#CBD5E1"/>
                                        <ComboBoxItem Content="纯白 (#FFFFFF)" Tag="#FFFFFF"/>
                                        <ComboBoxItem Content="柔和蓝 (#93C5FD)" Tag="#93C5FD"/>
                                        <ComboBoxItem Content="薄荷淡绿 (#86EFAC)" Tag="#86EFAC"/>
                                    </ComboBox>
                                </DockPanel>
                            </Grid>
                        </StackPanel>

                        <Separator Background="#2D333F" Margin="0,4,0,8"/>

                        <!-- 5. 攻防 / 忠诚度 -->
                        <TextBlock Text="■ 攻防 / 忠诚度" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,2,0,6"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock DockPanel.Dock="Right" x:Name="TxtPtSizeValue" Text="13 px" FontSize="11" Foreground="#FFAD42" Width="36" TextAlignment="Right"/>
                                <TextBlock Text="攻防字号:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Slider x:Name="SliderPtSize" Minimum="10" Maximum="22" Value="13" SmallChange="1" LargeChange="2" VerticalAlignment="Center" ValueChanged="SliderPtSize_ValueChanged"/>
                            </DockPanel>
                            <DockPanel Grid.Column="1">
                                <TextBlock Text="攻防颜色:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbPtColor" SelectionChanged="CmbPtColor_SelectionChanged">
                                    <ComboBoxItem Content="纯白 (#FFFFFF)" Tag="#FFFFFF"/>
                                    <ComboBoxItem Content="鲜黄 (#FDE047)" Tag="#FDE047"/>
                                    <ComboBoxItem Content="亮红 (#F87171)" Tag="#F87171"/>
                                    <ComboBoxItem Content="翠绿 (#4ADE80)" Tag="#4ADE80"/>
                                    <ComboBoxItem Content="暗灰 (#94A3B8)" Tag="#94A3B8"/>
                                </ComboBox>
                            </DockPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Footer Status Bar -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="0,8,0,0" BorderBrush="#2D333F" BorderThickness="0,1,0,0">
